[Unit]
Description=Barable Data Transfer Scheduler
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__USER__
WorkingDirectory=__HOME__/data_transfer
ExecStart=/usr/bin/python3 -u __HOME__/data_transfer/scheduler.py
Restart=on-failure
RestartSec=30

[Install]
WantedBy=multi-user.target
